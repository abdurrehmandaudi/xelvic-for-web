{
  "name": "xelvic-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite",
    "dev:live": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "build:desktop": "tsc -b && VITE_API_URL=http://127.0.0.1:47831 VITE_WS_URL=ws://127.0.0.1:47831 vite build",
    "desktop": "npm run build:desktop && electron desktop",
    "desktop:proxy": "node desktop/electron/proxy.cjs",
    "desktop:dist": "npm run build:desktop && cd desktop && ../node_modules/.bin/electron-builder --mac dmg",
    "desktop:dist:win": "npm run build:desktop && cd desktop && ../node_modules/.bin/electron-builder --win --x64",
    "desktop:dist:win:installer": "npm run build:desktop && cd desktop && ../node_modules/.bin/electron-builder --win nsis --x64",
    "desktop:dist:linux": "npm run build:desktop && cd desktop && ../node_modules/.bin/electron-builder --linux --x64",
    "desktop:dist:all": "npm run build:desktop && cd desktop && ../node_modules/.bin/electron-builder --mac dmg --win --x64 --linux --x64",
    "visionos:prepare": "npm run build:desktop && rm -rf visionos/XelvicVision/Resources/dist && cp -R dist visionos/XelvicVision/Resources/dist",
    "visionos:build": "npm run visionos:prepare && xcodebuild -project visionos/XelvicVision.xcodeproj -target XelvicVision -sdk xrsimulator -configuration Debug CODE_SIGNING_ALLOWED=NO build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "axios": "^1.21.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.61.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icon": "^1.0.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
